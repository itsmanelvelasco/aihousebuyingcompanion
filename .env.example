# ReloCat environment variables. Copy to `.env` for local use; never commit real values.
# Everything is optional for `npm run dev`, which generates its own local token.
# All of these are read through packages/config/env.ts.

# --- MCP server and journey board (apps/mcp-server, apps/board)
HOST=127.0.0.1
PORT=8787
# Comma-separated browser origins allowed to call /mcp. Empty allows non-browser clients only.
ALLOWED_ORIGINS=
# Public HTTPS origin of the board, used to build shareable board links.
PUBLIC_ORIGIN=
# HTTPS page of a separately deployed voice interviewer, opened by the Start talking card.
RELOCAT_VOICE_URL=
# Optional live listing search provider.
TREG_TOKEN=
TREG_ORG=

# --- Profile and bank API (apps/profile-api)
PROFILE_API_TOKEN=replace-with-a-local-random-token
# The habits service reads profiles from this directory too.
PROFILE_DATA_DIR=data/runtime-users
# Users whose simulated bank feed starts with the API, comma-separated.
DEMO_BANK_USERS=
DEMO_BANK_INTERVAL_MS=5000

# --- Connecting services to the profile API
# Board (connected mode):
PROFILE_API_URL=
# Standalone MCP server (read-only bank bridge); set both or neither:
BANK_API_URL=
BANK_API_TOKEN=

# --- `npm run dev` launcher ports
APP_PORT=8787
PROFILE_API_PORT=3001

# --- Habits service (apps/habits-agent)
HABITS_API_TOKEN=replace-with-a-local-random-token
HABITS_PORT=3002
HABITS_DATA_DIR=data/runtime-habits
HABITS_MAX_OUTPUT_TOKENS=1024
HABITS_DAILY_AI_CALLS=20

# --- Interviewer (apps/interviewer)
INTERVIEWER_PORT=3000

# --- OpenAI (optional, paid). Leave the key empty to keep every feature rule-based.
OPENAI_API_KEY=
OPENAI_HABITS_MODEL=gpt-6.2-sol
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna
REALTIME_MODEL=gpt-realtime-2.1

# --- Team plugin packaging (scripts/package-team-plugin.ts)
RELOCAT_MCP_URL=
