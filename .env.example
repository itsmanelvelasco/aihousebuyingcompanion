# ReloCat environment variables.
# Copy this file to `.env` (ignored by Git) and fill in only what you need.
# `npm run dev` works with every value left as it is here.
# All variables are read through packages/config/env.ts. Never commit real keys.

# =============================================================================
# 1. The server (apps/server): one origin for /mcp, /preview, /connect, /api
# =============================================================================
HOST=127.0.0.1
PORT=8787
# Public HTTPS origin once deployed, for example https://www.relo.cat.
# Used for shareable board links and widget permissions. Leave empty on localhost.
PUBLIC_ORIGIN=
# Browser origins allowed to call /mcp directly, comma-separated. Agents such as ChatGPT need none.
ALLOWED_ORIGINS=
# Bearer token for /api. Leave empty and the server generates a random one on each start;
# set it only when something outside the server process must call /api.
PROFILE_API_TOKEN=

# =============================================================================
# 2. Information inputs: where the data comes from
# =============================================================================

# --- 2a. Official place data (Idescat, Generalitat open data) -----------------
# Fetched at start, cached on disk and refreshed in the background.
# No API key is needed for the sources shipped today.
# `off` serves only the snapshot committed in data/towns.json.
LIVE_DATA=on
DATA_CACHE_DIR=data/cache
# A new source is one file in packages/sources/definitions/. If it needs a key,
# it declares the variable name itself; add it below when you add the source.

# --- 2b. Bank movements --------------------------------------------------------
# A bank is one file in packages/banks/providers/ (copy _template.ts).
# Each provider declares its own variables, always named
#   BANK_<PROVIDER_ID>_<NAME>      e.g. BANK_MY_BANK_CLIENT_ID, BANK_MY_BANK_WEBHOOK_SECRET
# A provider with a required variable missing is listed as "unconfigured" at /api/bank/providers.
# The built-in `synthetic` provider needs nothing.
#
# Banks call  POST <PUBLIC_ORIGIN>/api/webhooks/bank/<provider-id>  when there are new movements.
#
# Users whose synthetic demo feed starts with the server, comma-separated (for example user-001).
DEMO_BANK_USERS=user-001
DEMO_BANK_INTERVAL_MS=5000

# --- 2c. People: profiles, interview answers and habits ------------------------
# Runtime copies of the fictional profiles in data/users/, plus everything users add.
PROFILE_DATA_DIR=data/runtime-users
HABITS_DATA_DIR=data/runtime-habits

# --- 2d. Property listings (optional, paid per search) -------------------------
# Enables the search_homes tool. Without it the tool returns search links only.
TREG_TOKEN=
TREG_ORG=

# =============================================================================
# 3. AI services (optional, paid). Empty keeps every feature rule-based.
# =============================================================================
OPENAI_API_KEY=
# Habit suggestions on explicit request.
OPENAI_HABITS_MODEL=gpt-6.2-sol
HABITS_MAX_OUTPUT_TOKENS=1024
HABITS_DAILY_AI_CALLS=20
# Voice interview and transaction classification (apps/interviewer).
REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna

# =============================================================================
# 4. Other tools
# =============================================================================
# Standalone voice interviewer (npm run start:interviewer).
INTERVIEWER_PORT=3000
# HTTPS page of a deployed voice interviewer, opened by the "Start talking" card.
RELOCAT_VOICE_URL=
# Shared HTTPS /mcp endpoint baked into the team plugin (npm run package:team-plugin).
RELOCAT_MCP_URL=
# Board started on its own (npm run start:board) against a separate API; set both or neither.
PROFILE_API_URL=
