# ReloCat environment variables.
# Copy this file to `.env` (ignored by Git) and fill in only what you need.
# `npm run dev` works with every value left as it is here.
# All variables are read through packages/config/env.ts. Never commit real keys.

# =============================================================================
# 1. The server (apps/server): one origin for /mcp, /preview, /workspace, /interview, /connect, /api,
#    the account pages (/signup, /login, /account) and OAuth (/oauth/*)
# =============================================================================
HOST=127.0.0.1
PORT=8787
# Public HTTPS origin once deployed, for example https://www.relo.cat.
# Used for shareable board links, widget permissions, sign-in cookies and as the OAuth issuer.
# Leave empty on localhost.
PUBLIC_ORIGIN=
# Browser origins allowed to call /mcp directly, comma-separated. Agents such as ChatGPT need none.
ALLOWED_ORIGINS=
# Requests allowed per client address per minute. All clients together are allowed twenty
# times this. Every request is counted, also one from this machine; only calls that carry the
# admin token (PROFILE_API_TOKEN) are not.
# Empty: 300 on a public deployment (NODE_ENV=production or a PUBLIC_ORIGIN), 3000 otherwise. On
# your own machine every tab, the journey board (one poll a second per tab) and the test tools
# share the one address 127.0.0.1, and 300 a minute is five board tabs.
RATE_LIMIT_PER_MINUTE=
# The same for bank webhooks (/api/webhooks/bank/<provider>), which are counted separately so a
# bank's retries do not use up, or get blocked by, the limit above.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Which header states a visitor's address, for the rate limits and the sign-in throttle. A client
# can write any header, so one is believed only when you say which proxy of yours writes it:
#   auto              (default) headers are ignored, except X-Forwarded-For from a proxy or tunnel
#                     on this same machine. For local work only: with NODE_ENV=production or a
#                     PUBLIC_ORIGIN the server refuses to start until one of the three below is set.
#   x-forwarded-for   you run TRUSTED_PROXY_HOPS proxies in front (a reverse proxy on the same
#                     machine or a load balancer: 1; a CDN in front of a load balancer: 2).
#   cf-connecting-ip  (or another single-value header) your proxy overwrites it on every request
#                     and clients cannot reach the server around that proxy.
#   none              always the connecting address. Behind a proxy or in a container every visitor
#                     is then counted as one client; the server warns and /health shows it.
# The proxy must also pass the original Host header; see docs/areas/integration-deployment.md.
CLIENT_IP_HEADER=auto
TRUSTED_PROXY_HOPS=1
# Older switch: `on` means CLIENT_IP_HEADER=x-forwarded-for. It only counts while CLIENT_IP_HEADER is auto or empty.
TRUST_PROXY=off
# The Docker image sets NODE_ENV=production; do not set it here. In production Banc Demo and the
# default demo bank feed (section 2b) do not start unless DEMO_BANK=on is set explicitly.
# The operator's admin token for /api. Leave empty and the server generates a random one on each
# start; set it only when something outside the server process must call /api. A signed-in person
# reaches only their own /api/users/<id> with their own session or OAuth token, never with this.
PROFILE_API_TOKEN=

# --- Accounts and the public demo ----------------------------------------------
# Every stored person belongs to an account (see packages/auth/README.md). Read by accessConfig
# in packages/config/env.ts.
# `on`/`off`: the four fictional personas are readable without an account, read-only, through the
# demo tools and the journey board. Empty: on outside production, off in production.
PUBLIC_DEMO=
# The only user ids the public demo may ever read, comma-separated. Empty: user-001 to user-004.
# An id that belongs to an account is never served as a demo persona, even if listed here.
DEMO_USER_IDS=
# `on`/`off`: one journey board that everybody without a run id joins and may restart. A local
# convenience. Empty: on only outside production and without a PUBLIC_ORIGIN; otherwise every
# visitor gets a private run.
SHARED_BOARD=
# Extra Host values accepted besides the PUBLIC_ORIGIN host and localhost on PORT, comma-separated
# (for example a tunnel hostname, or localhost:8080 when Docker publishes another port). A request
# with any other Host is refused with 421.
ALLOWED_HOSTS=
# `off` closes sign-ups; existing accounts keep working. Empty: on.
SIGNUPS=
# The key bank credentials are encrypted with at rest (AES-256-GCM): what a bank's consent flow
# returns for a person's connection is stored sealed, never in clear. 32 random bytes, as 64 hex
# characters or as base64. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# and keep it with your other secrets: without it the stored credentials cannot be read, and every
# person has to connect their bank again. Changing it has the same effect.
# Empty: outside production a development key is created and kept in the database itself (logged
# once; it protects nothing against somebody who has the database file). In production the server
# refuses to start without a key while a bank that people connect by consent is configured.
DATA_ENCRYPTION_KEY=
# Private-use redirect URI schemes accepted from OAuth clients besides https and http on localhost,
# comma-separated (for example: cursor,vscode). Empty: none.
OAUTH_REDIRECT_SCHEMES=

# =============================================================================
# 2. Information inputs: where the data comes from
# =============================================================================

# --- 2a. Official place data (Idescat, Generalitat open data) -----------------
# Fetched at start, cached on disk and refreshed in the background.
# No API key is needed for the sources shipped today.
# `off` serves only the snapshot committed in data/towns.json.
LIVE_DATA=on
DATA_CACHE_DIR=data/cache
# Pins the Generalitat's annual resale-price workbook to one year (also for  npm run data:refresh).
# Empty: the latest year that has been published.
SALES_YEAR=
# A new source is one file in packages/sources/definitions/. If it needs a key,
# it declares the variable name itself; add it below when you add the source.

# --- 2b. Bank movements --------------------------------------------------------
# A bank is one file in packages/banks/providers/ (copy _template.ts).
# Each provider declares its own variables, always named
#   BANK_<PROVIDER_ID>_<NAME>      e.g. BANK_MY_BANK_CLIENT_ID, BANK_MY_BANK_WEBHOOK_SECRET
# A provider with a required variable missing is listed as "unconfigured" at /api/bank/providers.
# The built-in `synthetic` provider needs nothing.
#
# Banks call  POST <PUBLIC_ORIGIN>/api/webhooks/bank/<provider-id>  when there are new movements.
#
# Three fictional banks, none real (the table is in docs/areas/bank-runtime.md):
#   Banc Demo                  apps/demo-bank: the live one (API, signed webhooks, consent page)
#   in-process synthetic feed  a timer in the server; only for DEMO_BANK_USERS
#   data/demo-bank.csv         a fixed sample statement for /interview and sample_cash_flow
#
# Banc Demo: a fictional bank (apps/demo-bank) with a pull API and signed webhooks. The server
# starts it next to itself, connects it and links user-001 to its customer cust-001, so fictional
# movements keep arriving. Its keyed API listens on 127.0.0.1:DEMO_BANK_PORT (server to server
# only); the one page a person opens, the consent page, is served on the server's own origin:
#   <PUBLIC_ORIGIN or http://127.0.0.1:PORT>/banc-demo/consent/<id>
# and the bank sends the person back to  <same origin>/bank/consent/callback.  Nobody needs to
# reach port 3003 from outside, so the flow works through a tunnel and on a deployed site.
#   outside production   on unless DEMO_BANK=off (`off` returns user-001 to the in-process feed)
#   in production        OFF unless DEMO_BANK=on. The trade-off of turning it on: a public site then
#                        shows a bank feature that is entirely fictional. Every page, record and
#                        summary says so (fictional bank, synthetic: true) and no real account is
#                        touched, but visitors can link its invented customers to their accounts,
#                        and user-001's public demo ledger keeps growing. Leave it off for a site
#                        that connects real banks. It needs DATA_ENCRYPTION_KEY like any bank with a
#                        consent, and the server says at start that the fictional bank is on.
DEMO_BANK=on
DEMO_BANK_PORT=3003
#
# The in-process synthetic feed: users for whom it starts with the server, comma-separated.
# While DEMO_BANK=on, user-001 is fed by Banc Demo and never gets this feed as well, even when
# listed here: the server leaves it out and says so at start.
# Set and empty (DEMO_BANK_USERS=) means "nobody", also when DEMO_BANK=off.
# DEMO_BANK_USERS=user-002
# Milliseconds between movements of the in-process synthetic feed.
DEMO_BANK_INTERVAL_MS=5000
#
# The three variables of the `demo-bank` provider (ReloCat's side of Banc Demo). Left empty, the
# server invents them at each start, which is all a local demo needs. Give them values (any long
# random strings for the two secrets) to run the bank as its own process: set DEMO_BANK=off and
# PROFILE_API_TOKEN, then  npm run start:demo-bank,  npm run dev,  npm run demo-bank:connect
BANK_DEMO_BANK_BASE_URL=
BANK_DEMO_BANK_API_KEY=
BANK_DEMO_BANK_WEBHOOK_SECRET=
# Optional. Path on ReloCat's own origin where the bank's consent page is mounted. The server sets
# /banc-demo when it starts the bank itself. Empty with a bank you run as its own process: the
# person is sent to BANK_DEMO_BANK_BASE_URL, which their browser must then be able to reach.
BANK_DEMO_BANK_PUBLIC_PATH=
# The bank service itself (see apps/demo-bank/README.md). Its API key and signing secret default
# to the two values above; set these only to give the bank different ones.
DEMO_BANK_API_KEY=
DEMO_BANK_WEBHOOK_SECRET=
# Key of the bank's /simulate routes (fire a movement on demand). Empty: the API key.
DEMO_BANK_ADMIN_KEY=
# Milliseconds between the bank's simulated movements (100 to 3600000). Empty: DEMO_BANK_INTERVAL_MS.
DEMO_BANK_TICK_MS=
# Same seed, start date (YYYY-MM-DD, default three months before the first start) and customer
# count give the same fictional history. A snapshot keeps the seed and start date it began with.
DEMO_BANK_SEED=
DEMO_BANK_START_DATE=
DEMO_BANK_CUSTOMERS=4
# JSON file that keeps the bank's state across restarts. Empty: data/cache/demo-bank.json when the
# server starts the bank, none when the bank runs on its own.
DEMO_BANK_SNAPSHOT_FILE=
# `on` lets the bank call webhook URLs that are not on this machine. Leave off.
DEMO_BANK_ALLOW_REMOTE_WEBHOOKS=off
# Origins, comma-separated, the bank may send a customer back to after a consent, besides this
# machine. Empty: the server fills in its PUBLIC_ORIGIN and ALLOWED_HOSTS when it starts the bank.
DEMO_BANK_RETURN_ORIGINS=

# --- 2c. People: profiles, interview answers, bank ledgers and habits ----------
# All runtime state lives in one SQLite database: runtime copies of the fictional profiles in
# data/users/, everything users add, bank ledgers and connections, habits and board runs.
# Back it up while the server runs with  npm run db:backup -- <file>
DATABASE_FILE=data/relocat.db

# --- 2d. Property listings (optional, paid per search) -------------------------
# Enables the search_homes tool. Without it the tool returns search links only.
TREG_TOKEN=
TREG_ORG=
# search_homes needs no sign-in, so the server caps what it may spend: paid searches (one per
# town in a call, at most USD 0.01 each) per minute and per UTC day, for all callers together.
# Past a cap the tool answers budget_exhausted with the free search links. The counters are kept
# in the database, so a restart does not reset them. 0 disables paid search.
LISTINGS_PER_MINUTE_LIMIT=12
LISTINGS_DAILY_LIMIT=200
# Seconds an identical search is answered from memory instead of being paid for again.
LISTINGS_CACHE_SECONDS=600

# =============================================================================
# 3. AI services (optional, paid). Empty keeps every feature rule-based.
# =============================================================================
OPENAI_API_KEY=
# Habit suggestions on explicit request.
OPENAI_HABITS_MODEL=gpt-6.2-sol
HABITS_MAX_OUTPUT_TOKENS=1024
HABITS_DAILY_AI_CALLS=20
# Voice interview and transaction classification (apps/interviewer).
REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna
# Illustrations (npm run images:generate): uses OPENAI_API_KEY above, one paid request per image.
# Model for those images; leave as is unless the account lacks access to it.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Voice and OpenAI categorization at /interview spend OPENAI_API_KEY credits, so they answer only
# same-origin requests from this machine. `on` opens them to visitors of the public site.
INTERVIEWER_PUBLIC_AI=off
# Paid requests one visitor may make per hour when public; all visitors together get ten times this.
INTERVIEWER_AI_REQUESTS_PER_HOUR=20
# Other sites whose pages may call /interview/voice when INTERVIEWER_PUBLIC_AI is on. This is what puts
# the voice interview inside the ReloCat card in ChatGPT: the card runs on the chat host's origin and
# calls this server from there. Comma-separated origins (https://chat.example), host suffixes for
# https origins (.oaiusercontent.com) or * for any origin. Empty: none, and the card continues in the chat.
# Every call spends OPENAI_API_KEY credits under the hourly limits above; a refused origin is logged
# once so you can see what to allow.
INTERVIEWER_EMBED_ORIGINS=

# =============================================================================
# 4. Other tools
# =============================================================================
# Standalone voice interviewer (npm run start:interviewer).
INTERVIEWER_PORT=3000
# HTTPS page of a voice interviewer, opened by the "Start talking" card. Empty: the product's own
# page, <PUBLIC_ORIGIN>/interview/, when a public origin is set; otherwise the card shows no link.
RELOCAT_VOICE_URL=
# Shared HTTPS /mcp endpoint baked into the team plugin (npm run package:team-plugin).
RELOCAT_MCP_URL=
# Base URL of a running ReloCat API, for example http://127.0.0.1:8787/api. Read only by
#   npm run demo-bank:connect
# which links a separately started Banc Demo to ReloCat with PROFILE_API_TOKEN. Empty: this
# machine's PORT.
PROFILE_API_URL=

# =============================================================================
# 5. Leftovers from versions without a database. Nothing writes to these.
# =============================================================================
# Where JSON files of an earlier version are imported from: once, on the first start with an empty
# database, and by  npm run db:import-legacy . The files are read, never changed. Leave them
# commented out unless you are migrating such a folder; the values shown are the defaults.
# PROFILE_DATA_DIR=data/runtime-users
# HABITS_DATA_DIR=data/runtime-habits
