{
  "name": "relocat",
  "version": "0.2.0",
  "description": "ReloCat: a housing companion for people considering a move within Catalonia.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "npm run build && node --watch-path=apps --watch-path=packages --env-file-if-exists=.env apps/server/index.ts",
    "start": "npm run build && node --env-file-if-exists=.env apps/server/index.ts",
    "start:board": "npm run build && node --env-file-if-exists=.env apps/board/server.ts",
    "start:interviewer": "npm run build && node --env-file-if-exists=.env apps/interviewer/server.ts",
    "start:demo-bank": "node --env-file-if-exists=.env apps/demo-bank/server.ts",
    "demo-bank:connect": "node --env-file-if-exists=.env scripts/connect-demo-bank.ts",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run data:validate",
    "data:validate": "node scripts/validate-data.ts",
    "data:refresh": "node --env-file-if-exists=.env scripts/refresh-data.ts",
    "generate:users": "node scripts/generate-users.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.ts",
    "db:import-legacy": "node --env-file-if-exists=.env scripts/import-legacy.ts",
    "package:team-plugin": "node --env-file-if-exists=.env scripts/package-team-plugin.ts",
    "images:generate": "node --env-file-if-exists=.env scripts/generate-images.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0"
  }
}
