{
  "name": "relocat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch apps/profile-api/server.ts",
    "start": "node apps/profile-api/server.ts",
    "setup:app": "npm --prefix demo-plugin ci",
    "build:app": "npm --prefix demo-plugin run build",
    "check:app": "npm --prefix demo-plugin run check",
    "test:app": "npm --prefix demo-plugin test",
    "dev:stack": "npm run build:app && node scripts/dev-stack.ts",
    "generate:users": "node scripts/generate-users.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:mcp": "node --watch apps/mcp-server/index.ts",
    "start:mcp": "node apps/mcp-server/index.ts",
    "data:validate": "node scripts/validate-data.ts",
    "data:refresh": "node scripts/refresh-data.ts"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.20"
  }
}
